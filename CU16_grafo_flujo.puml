@startuml CU16_Grafo_Flujo

title Grafo de Flujo de Control - CU16: Configurar Punto de Acceso (onSubmit + updateAccessPoint)

state "Inicio" as Inicio
state "1" as N1
state "2" as N2
state "3" as N3
state "4" as N4
state "5" as N5
state "6" as N6
state "7" as N7
state "F" as F

[*] --> Inicio
Inicio --> N1
N1 --> F   : V
N1 --> N2  : F
N2 --> N7  : error
N2 --> N3  : ok
N3 --> N4
N4 --> N7  : V
N4 --> N5  : F
N5 --> N6
N6 --> F
N7 --> F
F --> [*]

@enduml
