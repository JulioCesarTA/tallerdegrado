# ─── IP / Dominio público de tu EC2 ──────────────────────────────────────────
# Usá la IP pública de EC2 o tu dominio si tenés uno.
# Ejemplo: EC2_HOST=54.123.45.67   o   EC2_HOST=mi-dominio.com
EC2_HOST=TU_IP_PUBLICA_EC2

# ─── Base de datos ────────────────────────────────────────────────────────────
DB_USERNAME=admin
DB_PASSWORD=cambia_esta_password_segura

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generá un secreto fuerte: openssl rand -hex 64
JWT_SECRET=cambia_este_secreto_muy_largo_y_seguro

# ─── AWS ──────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=us-east-2
AWS_REKOGNITION_REGION=us-east-2
AWS_S3_BUCKET=proyectodegrado1
AWS_S3_EVIDENCE_PREFIX=evidences
AWS_S3_BACKUP_PREFIX=backups

# ─── Claude AI ────────────────────────────────────────────────────────────────
CLAUDE_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-haiku-4-5-20251001
